   "audio": "../10_Audio/narration/SC044.wav"
  },
  {
   "id": 45,
   "file": "SC045",
   "section": "The bill",
   "start": 338.914,
   "duration": 9.375,
   "narration": "Their estimate: roughly a hundred thousand extra deaths a year. About half a million people between 2000 and 2005.",
   "visual": {
    "type": "card",
