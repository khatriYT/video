     "style": "chapter",
     "main": "NO VULTURES",
     "sub": "Chapter 3"
    }
   },
   "clip": "../09_Animation/SC029.mp4",
   "audio": "../10_Audio/narration/SC029.wav"
  },
  {
   "id": 30,
   "file": "SC030",
   "section": "A world without vultures",
   "start": 221.583,
   "duration": 6.958,
   "narration": "A few crows peck at it. They can't open a carcass this big. So it just lies there, in the heat.",
   "visual": {
    "type": "plate",
    "shot": "P03C",
    "move": "push",
    "fx": [
     "heat"
    ]
   },
   "clip": "../09_Animation/SC030.mp4",
   "audio": "../10_Audio/narration/SC030.wav"
  },
  {
   "id": 31,
   "file": "SC031",
   "section": "A world without vultures",
   "start": 228.541,
   "duration": 4.0,
   "narration": "Day three. The flies arrive. Then thousands more.",
   "visual": {
    "type": "plate",
    "shot": "P04",
    "move": "push",
    "tab": "DAY 3",
    "fx": [
     "flies"
    ]
   },
   "clip": "../09_Animation/SC031.mp4",
   "audio": "../10_Audio/narration/SC031.wav"
  },
  {
