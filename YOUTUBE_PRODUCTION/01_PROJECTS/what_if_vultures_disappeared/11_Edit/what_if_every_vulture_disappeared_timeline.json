   "clip": "../09_Animation/SC057.mp4",
   "audio": "../10_Audio/narration/SC057.wav"
  },
  {
   "id": 58,
   "file": "SC058",
   "section": "Could anything replace them?",
   "start": 459.872,
   "duration": 4.875,
   "narration": "So if vultures vanished everywhere, would something else simply step in?",
   "visual": {
    "type": "plate",
