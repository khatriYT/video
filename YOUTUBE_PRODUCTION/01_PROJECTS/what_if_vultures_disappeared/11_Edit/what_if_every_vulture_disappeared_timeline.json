   "clip": "../09_Animation/SC061.mp4",
   "audio": "../10_Audio/narration/SC061.wav"
  },
  {
   "id": 62,
   "file": "SC062",
   "section": "Could anything replace them?",
   "start": 491.33,
   "duration": 7.042,
   "narration": "Ecologists call that a keystone loss: pull out one stone, and the whole arch starts to lean.",
