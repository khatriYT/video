   "audio": "../10_Audio/narration/SC039.wav"
  },
  {
   "id": 40,
   "file": "SC040",
   "section": "A world without vultures",
   "start": 297.748,
   "duration": 5.083,
   "narration": "Year ten. The dump has become a field of bones, and the dogs own it.",
   "visual": {
    "type": "plate",
    "shot": "P07",
    "move": "push",
