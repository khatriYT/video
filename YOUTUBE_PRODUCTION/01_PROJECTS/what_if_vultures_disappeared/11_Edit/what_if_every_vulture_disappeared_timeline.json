   "audio": "../10_Audio/narration/SC046.wav"
  },
  {
   "id": 47,
   "file": "SC047",
   "section": "Ripples",
   "start": 358.831,
   "duration": 3.667,
   "narration": "The loss reached places you might not expect.",
   "visual": {
    "type": "plate",
    "shot": "P20",
    "move": "push",
    "text": {
     "style": "chapter",
     "main": "RIPPLES",
     "sub": "Chapter 5"
    }
