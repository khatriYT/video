    "icons": "vultures_fade"
   },
   "clip": "../09_Animation/SC005.mp4",
   "audio": "../10_Audio/narration/SC005.wav"
  },
  {
   "id": 6,
   "file": "SC006",
   "section": "Cold open",
   "start": 36.708,
   "duration": 6.833,
   "narration": "What happened next turned one of the world's most hated birds into one of its most expensive losses.",
   "visual": {
    "type": "plate",
    "shot": "P03",
    "move": "pull",
    "tab": "DAY 1 \u00b7 No vultures"
   },
   "clip": "../09_Animation/SC006.mp4",
   "audio": "../10_Audio/narration/SC006.wav"
  },
  {
   "id": 7,
   "file": "SC007",
   "section": "Cold open",
   "start": 43.541,
   "duration": 8.417,
   "narration": "So what really happens when the vultures disappear? We don't have to guess. India already ran the experiment.",
   "visual": {
    "type": "plate",
    "shot": "P12",
    "move": "rise",
    "text": {
     "style": "title",
     "main": "WHAT IF EVERY VULTURE",
     "sub": "DISAPPEARED?"
    }
   },
   "clip": "../09_Animation/SC007.mp4",
   "audio": "../10_Audio/narration/SC007.wav"
  },
  {
   "id": 8,
   "file": "SC008",
   "section": "Cold open",
   "start": 51.958,
   "duration": 8.333,
   "narration": "Welcome to The Disappearance Files, where we find out what the world loses when an animal nobody likes is suddenly gone.",
   "visual": {
    "type": "plate",
    "shot": "P09",
    "move": "push"
   },
   "clip": "../09_Animation/SC008.mp4",
   "audio": "../10_Audio/narration/SC008.wav"
  },
  {
   "id": 9,
   "file": "SC009",
   "section": "Meet the cleanup crew",
   "start": 60.291,
   "duration": 2.542,
   "narration": "First, meet the cleanup crew.",
   "visual": {
    "type": "plate",
    "shot": "P13",
    "move": "push",
    "text": {
     "style": "chapter",
     "main": "THE CLEANUP CREW",
