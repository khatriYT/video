   "audio": "../10_Audio/narration/SC045.wav"
  },
  {
   "id": 46,
   "file": "SC046",
   "section": "The bill",
   "start": 348.289,
   "duration": 10.542,
   "narration": "That's a statistical estimate, not a body count. But it puts a price on the bird nobody wanted: about sixty-nine billion dollars, every year.",
   "visual": {
    "type": "card",
    "card": "bignum",
    "value": "$69 bn",
    "label": "per year in mortality costs (estimate)",
    "tag": "ESTIMATE"
