   "audio": "../10_Audio/narration/SC058.wav"
  },
  {
   "id": 59,
   "file": "SC059",
   "section": "Could anything replace them?",
   "start": 464.747,
   "duration": 6.833,
   "narration": "Partly. Dogs, jackals, hyenas, crows, rats, flies and bacteria would all take a share.",
   "visual": {
