   "clip": "../09_Animation/SC060.mp4",
   "audio": "../10_Audio/narration/SC060.wav"
  },
  {
   "id": 61,
   "file": "SC061",
   "section": "Could anything replace them?",
   "start": 480.997,
   "duration": 10.333,
   "narration": "The experiments point the same way. Without vultures, carcasses last longer, and the animals that replace them spread more disease, not less.",
   "visual": {
    "type": "plate",
    "shot": "P06",
    "move": "push",
    "fx": [
